{
  "name": "scaleway-dns-check",
  "description": "A small utility that checks the health of a list of IPs and updates Scaleway DNS records to point to the healthy IP.",
  "version": "1.1.0",
  "main": "index.ts",
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch src",
    "build": "tsc -p ./tsconfig.json",
    "start": "node ./dist/index",
    "build:production": "webpack"
  },
  "dependencies": {
    "@scaleway/sdk": "^3.11.1",
    "dotenv": "^17.4.2",
    "node-fetch": "^3.3.2",
    "tracer": "^1.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "ts-loader": "^9.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "webpack": "^5.109.2",
    "webpack-cli": "^6.0.1"
  }
}
